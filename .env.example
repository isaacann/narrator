# Copy this file to `.env.local` and fill in at least one key, then restart the dev server.
# ElevenLabs is preferred when both keys are present (best English + 中文 mixed rendering).

# ElevenLabs — https://elevenlabs.io → Profile → API Keys
ELEVENLABS_API_KEY=

# OpenAI — https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Optional: force a specific provider instead of auto-detection.
# Only takes effect if the matching API key is set. Accepted values: "elevenlabs" | "openai"
# TTS_PROVIDER=
